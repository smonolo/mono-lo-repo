{
  "name": "mono-lo-repo",
  "version": "1.0.0",
  "author": "Stefano Monolo <stefano@smnl.dev>",
  "workspaces": [
    "apps/*",
    "plugins/*"
  ],
  "packageManager": "npm@11.2.0",
  "scripts": {
    "format": "prettier . --write",
    "dev:website": "turbo dev --filter=website",
    "dev:resume": "turbo dev --filter=resume",
    "dev:resume-template": "turbo dev --filter=resume-template",
    "dev:cdn": "turbo dev --filter=cdn",
    "dev:mfd": "turbo dev --filter=mfd",
    "dev:site": "turbo dev --filter=site",
    "dev:minecraft": "turbo dev --filter=minecraft",
    "dev:minecraft-api": "turbo dev --filter=minecraft-api",
    "dev:minecraft:full": "turbo dev --filter=minecraft --filter=minecraft-api",
    "dev:email-checker": "turbo dev --filter=email-checker",
    "dev:email-checker-api": "turbo dev --filter=email-checker-api",
    "dev:email-checker:full": "turbo dev --filter=email-checker --filter=email-checker-api",
    "dev": "turbo dev",
    "build:website": "turbo build --filter=website",
    "build:resume": "turbo build --filter=resume",
    "build:resume-template": "turbo build --filter=resume-template",
    "build:dev": "turbo build --filter=cdn",
    "build:mfd": "turbo build --filter=mfd",
    "build:cdn-ui": "turbo build --filter=cdn-ui",
    "build:site": "turbo build --filter=site",
    "build:minecraft": "turbo build --filter=minecraft",
    "build:minecraft-api": "turbo build --filter=minecraft-api",
    "build:email-checker": "turbo build --filter=email-checker",
    "build:email-checker-api": "turbo build --filter=email-checker-api",
    "build:smessential": "turbo build --filter=smessential",
    "build": "turbo build"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.10.12"
  },
  "overrides": {
    "ajv": "^8.17.2",
    "body-parser": "^1.20.6",
    "brace-expansion": "^1.1.18",
    "file-type": "^22.0.2",
    "glob": "^10.4.6",
    "multer": "^2.1.2",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.23",
    "qs": "^6.15.2",
    "tmp": "^0.2.6",
    "webpack": "^5.104.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.2": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
