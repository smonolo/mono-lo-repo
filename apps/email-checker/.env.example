# URL of the verification backend service
EMAIL_CHECKER_API_URL=http://localhost:4000

# Shared secret key between Next.js frontend and the backend API (optional for local dev, recommended in production)
EMAIL_CHECKER_API_KEY=your-secure-random-token-here

# Optional UI customization
NEXT_PUBLIC_AUTHOR_NAME=Your Name
NEXT_PUBLIC_REPO_URL=https://github.com/yourusername/yourrepo
