PORT=4000

# Domain used in EHLO and default MAIL FROM commands (recommend using a dedicated subdomain)
SENDER_DOMAIN=verify.yourdomain.com

# Sender email address used in MAIL FROM (e.g. check@verify.yourdomain.com or <> for RFC 5321 null sender)
SENDER_ADDRESS=check@verify.yourdomain.com

# Shared secret key to protect the backend API from direct public access
API_SECRET_KEY=your-secure-random-token-here

# Maximum number of concurrent active SMTP socket connections
MAX_CONCURRENT_PROBES=10
